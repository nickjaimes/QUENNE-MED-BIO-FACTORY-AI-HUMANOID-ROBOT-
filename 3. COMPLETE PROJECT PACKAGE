        # Summary statistics
        for metric_name, values in self.metrics.items():
            if values:
                report['summary'][metric_name] = {
                    'mean': np.mean(values),
                    'std': np.std(values),
                    'min': np.min(values),
                    'max': np.max(values),
                    'count': len(values),
                }
        
        # Detailed metrics
        report['detailed_metrics'] = self.metrics.copy()
        
        # Trends (last 10 prints)
        for metric_name, values in self.metrics.items():
            if len(values) >= 2:
                recent_values = values[-10:] if len(values) >= 10 else values
                trend = np.polyfit(range(len(recent_values)), recent_values, 1)[0]
                report['trends'][metric_name] = trend
        
        return report

