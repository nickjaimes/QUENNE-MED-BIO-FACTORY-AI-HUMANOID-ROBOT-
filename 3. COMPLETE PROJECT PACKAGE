        cache_key = self._generate_cache_key(start_pose, goal_pose, anatomy)
        self.plan_cache[cache_key] = {
            'trajectory': trajectory,
            'planning_time': planning_time,
            'safety_verified': safety_verified,
        }
        
        return {
            'trajectory': trajectory,
            'planning_time': planning_time,
            'safety_verified': safety_verified,
            'path_length': path_length,
            'cache_key': cache_key,
        }
    
    def _plan_rrt_star(
        self,
        start: np.ndarray,
        goal: np.ndarray,
        anatomy: Dict[str, AnatomicalStructure],
        tool: Dict[str, Any]
    ) -> List[np.ndarray]:
        """RRT* algorithm for surgical path planning"""
        
        # Configuration space dimensions
        dim = len(start)
        
        # Parameters
        max_iterations = 10000
        goal_bias = 0.1
        step_size = 0.5  # mm
        neighbor_radius = 2.0  # mm
        
        # Initialize tree
        tree = {
            'nodes': [start],
            'parents': [-1],
            'costs': [0.0],
        }
        
        # KDTree for efficient nearest neighbor search
        kdtree = KDTree([start])
        
        for iteration in range(max_iterations):
            # Sample random configuration
            if np.random.random() < goal_bias:
                sample = goal
            else:
                sample = self._sample_configuration_space(anatomy, tool)
            
            # Find nearest neighbor
            _, nearest_idx = kdtree.query(sample)
            nearest = tree['nodes'][nearest_idx]
            
            # Steer towards sample
            new_node = self._steer(nearest, sample, step_size)
            
            # Check collision
            if self._check_collision(nearest, new_node, anatomy, tool):
                continue
            
            # Find near neighbors
            near_indices = kdtree.query_ball_point(new_node, neighbor_radius)
            
            # Choose best parent
            best_parent = nearest_idx
            min_cost = tree['costs'][nearest_idx] + \
                       self._distance(nearest, new_node)
            
            for near_idx in near_indices:
                near_node = tree['nodes'][near_idx]
                cost = tree['costs'][near_idx] + \
                       self._distance(near_node, new_node)
                
                if cost < min_cost and not self._check_collision(
                    near_node, new_node, anatomy, tool
                ):
                    best_parent = near_idx
                    min_cost = cost
            
            # Add to tree
            new_idx = len(tree['nodes'])
            tree['nodes'].append(new_node)
            tree['parents'].append(best_parent)
            tree['costs'].append(min_cost)
            kdtree = KDTree(tree['nodes'])  # Update KDTree
            
            # Rewire tree
            for near_idx in near_indices:
                near_node = tree['nodes'][near_idx]
                new_cost = min_cost + self._distance(new_node, near_node)
                
                if new_cost < tree['costs'][near_idx] and \
                   not self._check_collision(new_node, near_node, anatomy, tool):
                    tree['parents'][near_idx] = new_idx
                    tree['costs'][near_idx] = new_cost
            
            # Check if goal reached
            if self._distance(new_node, goal) < self.constraints.position_tolerance:
                break
        
        # Extract path
        path = self._extract_path(tree, goal)
        
        return path
    
    def _optimize_trajectory(
        self,
        path: List[np.ndarray],
        anatomy: Dict[str, AnatomicalStructure],
        tool: Dict[str, Any]
    ) -> List[np.ndarray]:
        """Optimize trajectory for smoothness and safety"""
        
        if len(path) < 3:
            return path
        
        # Convert to numpy array
        path_array = np.array(path)
        
        # Apply smoothing
        smoothed = self._smooth_path(path_array, anatomy, tool)
        
        # Optimize waypoints
        optimized = self._optimize_waypoints(smoothed, anatomy, tool)
        
        # Add intermediate points for precision
        refined = self._refine_trajectory(optimized, anatomy, tool)
        
        return refined
    
    def _smooth_path(
        self,
        path: np.ndarray,
        anatomy: Dict[str, AnatomicalStructure],
        tool: Dict[str, Any]
    ) -> np.ndarray:
        """Smooth path using cubic splines"""
        
        # Parameterize by arc length
        t = np.zeros(len(path))
        for i in range(1, len(path)):
            t[i] = t[i-1] + np.linalg.norm(path[i] - path[i-1])
        
        # Create cubic splines for each dimension
        smoothed = []
        for dim in range(path.shape[1]):
            spline = CubicSpline(t, path[:, dim])
            
            # Evaluate at finer resolution
            t_fine = np.linspace(0, t[-1], len(path) * 10)
            smoothed_dim = spline(t_fine)
            smoothed.append(smoothed_dim)
        
        smoothed = np.column_stack(smoothed)
        
        # Ensure collision-free
        for i in range(1, len(smoothed)):
            if self._check_collision(smoothed[i-1], smoothed[i], anatomy, tool):
                # Fall back to original path segment
                smoothed[i] = path[min(i // 10, len(path)-1)]
        
        return smoothed
    
    def _optimize_waypoints(
        self,
        path: np.ndarray,
        anatomy: Dict[str, AnatomicalStructure],
        tool: Dict[str, Any]
    ) -> np.ndarray:
        """Optimize waypoints using gradient-based optimization"""
        
        # Convert to tensor for optimization
        path_tensor = torch.tensor(path, dtype=torch.float32, requires_grad=True)
        
        # Optimization parameters
        learning_rate = 0.01
        iterations = 100
        
        optimizer = torch.optim.Adam([path_tensor], lr=learning_rate)
        
        for iteration in range(iterations):
            optimizer.zero_grad()
            
            # Calculate losses
            smoothness_loss = self._calculate_smoothness_loss(path_tensor)
            safety_loss = self._calculate_safety_loss(path_tensor, anatomy, tool)
            length_loss = self._calculate_length_loss(path_tensor)
            
            # Total loss
            total_loss = (
                0.5 * smoothness_loss +
                2.0 * safety_loss +
                0.1 * length_loss
            )
            
            # Backpropagation
            total_loss.backward()
            optimizer.step()
            
            # Project back to feasible space
            with torch.no_grad():
                path_tensor.data = self._project_to_feasible_space(
                    path_tensor.data, anatomy, tool
                )
        
        return path_tensor.detach().numpy()
    
    def _add_motion_profile(
        self,
        path: np.ndarray,
        tool: Dict[str, Any]
    ) -> Dict[str, Any]:
        """Add motion profile (velocity, acceleration, jerk) to path"""
        
        # Calculate time-optimal trajectory
        trajectory = self._calculate_time_optimal_profile(path, tool)
        
        # Add force profile
        force_profile = self._calculate_force_profile(trajectory, tool)
        
        # Add safety margins
        safety_margins = self._calculate_safety_margins(trajectory)
        
        return {
            'positions': trajectory['positions'],
            'velocities': trajectory['velocities'],
            'accelerations': trajectory['accelerations'],
            'jerks': trajectory['jerks'],
            'times': trajectory['times'],
            'forces': force_profile['forces'],
            'torques': force_profile['torques'],
            'safety_margins': safety_margins,
        }
    
    def _calculate_time_optimal_profile(
        self,
        path: np.ndarray,
        tool: Dict[str, Any]
    ) -> Dict[str, np.ndarray]:
        """Calculate time-optimal motion profile"""
        
        # Implementation of time-optimal trajectory planning
        # with constraints on velocity, acceleration, and jerk
        
        n_points = len(path)
        
        # Calculate path distances
        distances = np.zeros(n_points)
        for i in range(1, n_points):
            distances[i] = distances[i-1] + np.linalg.norm(path[i] - path[i-1])
        
        # Forward pass: calculate maximum velocities
        v_max = np.zeros(n_points)
        v_max[0] = 0.0
        
        for i in range(1, n_points):
            delta_s = distances[i] - distances[i-1]
            
            # Maximum velocity from acceleration constraint
            v_from_acc = np.sqrt(
                v_max[i-1]**2 + 2 * self.constraints.max_acceleration * delta_s
            )
            
            # Maximum velocity from tool capabilities
            v_tool = tool.get('max_velocity', self.constraints.max_velocity)
            
            v_max[i] = min(v_from_acc, v_tool, self.constraints.max_velocity)
        
        # Backward pass: apply deceleration constraints
        v_actual = np.copy(v_max)
        v_actual[-1] = 0.0
        
        for i in range(n_points-2, -1, -1):
            delta_s = distances[i+1] - distances[i]
            
            # Required velocity for deceleration
            v_req = np.sqrt(
                v_actual[i+1]**2 + 2 * self.constraints.max_acceleration * delta_s
            )
            
            v_actual[i] = min(v_actual[i], v_req)
        
        # Calculate times
        times = np.zeros(n_points)
        for i in range(1, n_points):
            if abs(v_actual[i] - v_actual[i-1]) < 1e-6:
                # Constant velocity
                delta_t = (distances[i] - distances[i-1]) / v_actual[i]
            else:
                # Accelerating/decelerating
                delta_t = 2 * (distances[i] - distances[i-1]) / \
                          (v_actual[i] + v_actual[i-1])
            
            times[i] = times[i-1] + delta_t
        
        # Interpolate for smooth profile
        positions = []
        velocities = []
        accelerations = []
        jerks = []
        fine_times = []
        
        dt = 0.001  # 1 ms resolution
        current_time = 0.0
        
        while current_time <= times[-1]:
            # Find segment
            idx = np.searchsorted(times, current_time) - 1
            idx = max(0, min(idx, n_points-2))
            
            # Interpolate within segment
            t0, t1 = times[idx], times[idx+1]
            alpha = (current_time - t0) / (t1 - t0) if t1 > t0 else 0.0
            alpha = np.clip(alpha, 0.0, 1.0)
            
            # Position (cubic interpolation for smoothness)
            pos0, pos1 = path[idx], path[idx+1]
            vel0, vel1 = v_actual[idx], v_actual[idx+1]
            
            # Hermite interpolation
            h00 = 2*alpha**3 - 3*alpha**2 + 1
            h10 = alpha**3 - 2*alpha**2 + alpha
            h01 = -2*alpha**3 + 3*alpha**2
            h11 = alpha**3 - alpha**2
            
            position = h00*pos0 + h10*(t1-t0)*vel0 + h01*pos1 + h11*(t1-t0)*vel1
            
            # Velocity
            dh00 = 6*alpha**2 - 6*alpha
            dh10 = 3*alpha**2 - 4*alpha + 1
            dh01 = -6*alpha**2 + 6*alpha
            dh11 = 3*alpha**2 - 2*alpha
            
            velocity = (dh00*pos0 + dh10*(t1-t0)*vel0 + 
                       dh01*pos1 + dh11*(t1-t0)*vel1) / (t1-t0)
            
            # Acceleration
            d2h00 = 12*alpha - 6
            d2h10 = 6*alpha - 4
            d2h01 = -12*alpha + 6
            d2h11 = 6*alpha - 2
            
            acceleration = (d2h00*pos0 + d2h10*(t1-t0)*vel0 +
                           d2h01*pos1 + d2h11*(t1-t0)*vel1) / (t1-t0)**2
            
            # Jerk
            d3h00 = 12
            d3h10 = 6
            d3h01 = -12
            d3h11 = 6
            
            jerk = (d3h00*pos0 + d3h10*(t1-t0)*vel0 +
                   d3h01*pos1 + d3h11*(t1-t0)*vel1) / (t1-t0)**3
            
            positions.append(position)
            velocities.append(velocity)
            accelerations.append(acceleration)
            jerks.append(jerk)
            fine_times.append(current_time)
            
            current_time += dt
        
        return {
            'positions': np.array(positions),
            'velocities': np.array(velocities),
            'accelerations': np.array(accelerations),
            'jerks': np.array(jerks),
            'times': np.array(fine_times),
        }
    
    def _verify_trajectory_safety(
        self,
        trajectory: Dict[str, Any],
        anatomy: Dict[str, AnatomicalStructure]
    ) -> bool:
        """Verify trajectory safety with all constraints"""
        
        # Check all safety monitors
        for monitor in self.safety_monitors:
            if not monitor(trajectory, anatomy):
                return False
        
        # Additional safety checks
        safety_checks = [
            self._check_position_limits,
            self._check_velocity_limits,
            self._check_acceleration_limits,
            self._check_force_limits,
            self._check_collision_free,
            self._check_temporal_constraints,
        ]
        
        for check in safety_checks:
            if not check(trajectory, anatomy):
                return False
        
        return True
    
    def _monitor_position_safety(
        self,
        trajectory: Dict[str, Any],
        anatomy: Dict[str, AnatomicalStructure]
    ) -> bool:
        """Monitor position safety"""
        
        positions = trajectory['positions']
        
        for i, pos in enumerate(positions):
            # Check against anatomical constraints
            for name, structure in anatomy.items():
                if structure.critical:
                    distance = self._distance_to_structure(pos, structure)
                    if distance < structure.safety_margin:
                        return False
            
            # Check workspace limits
            if not self._is_within_workspace(pos):
                return False
        
        return True
    
    def execute_trajectory(
        self,
        trajectory: Dict[str, Any],
        real_time_callback: Optional[callable] = None
    ) -> Dict[str, Any]:
        """Execute planned trajectory with real-time monitoring"""
        
        execution_result = {
            'success': True,
            'deviations': [],
            'safety_violations': [],
            'execution_time': 0.0,
        }
        
        start_time = time.time()
        
        positions = trajectory['positions']
        velocities = trajectory['velocities']
        times = trajectory['times']
        
        for i in range(len(positions)):
            # Check if execution should continue
            if real_time_callback:
                should_continue = real_time_callback(i, positions[i])
                if not should_continue:
                    execution_result['success'] = False
                    break
            
            # Move to position
            current_position = self._get_current_position()
            target_position = positions[i]
            
            # Calculate error
            error = np.linalg.norm(current_position - target_position)
            execution_result['deviations'].append(error)
            
            # Check safety
            if error > self.constraints.max_position_error:
                execution_result['safety_violations'].append({
                    'type': 'position_error',
                    'value': error,
                    'time': times[i],
                })
            
            # Apply control
            self._apply_control(target_position, velocities[i])
            
            # Wait for next timestep
            elapsed = time.time() - start_time
            expected = times[i]
            
            if elapsed < expected:
                time.sleep(expected - elapsed)
            else:
                execution_result['safety_violations'].append({
                    'type': 'timing_error',
                    'value': elapsed - expected,
                    'time': times[i],
                })
        
        execution_result['execution_time'] = time.time() - start_time
        
        return execution_result
    
    # Utility methods
    def _validate_inputs(
        self,
        start: np.ndarray,
        goal: np.ndarray,
        tool: Dict[str, Any]
    ):
        """Validate input parameters"""
        
        assert len(start) == len(goal), "Start and goal must have same dimension"
        assert np.all(np.isfinite(start)), "Start position must be finite"
        assert np.all(np.isfinite(goal)), "Goal position must be finite"
        
        # Check tool parameters
        required_tool_params = ['dimensions', 'max_force', 'stiffness']
        for param in required_tool_params:
            assert param in tool, f"Tool missing required parameter: {param}"
    
    def _sample_configuration_space(
        self,
        anatomy: Dict[str, AnatomicalStructure],
        tool: Dict[str, Any]
    ) -> np.ndarray:
        """Sample configuration space"""
        
        # Get workspace bounds
        bounds = self._get_workspace_bounds(anatomy, tool)
        
        # Sample uniformly within bounds
        sample = np.random.uniform(
            low=bounds['min'],
            high=bounds['max']
        )
        
        return sample
    
    def _steer(
        self,
        from_pos: np.ndarray,
        to_pos: np.ndarray,
        step_size: float
    ) -> np.ndarray:
        """Steer from one position to another"""
        
        direction = to_pos - from_pos
        distance = np.linalg.norm(direction)
        
        if distance < step_size:
            return to_pos
        
        direction = direction / distance
        return from_pos + direction * step_size
    
    def _check_collision(
        self,
        pos1: np.ndarray,
        pos2: np.ndarray,
        anatomy: Dict[str, AnatomicalStructure],
        tool: Dict[str, Any]
    ) -> bool:
        """Check for collision between two positions"""
        
        # Create line segment
        num_checks = max(2, int(np.linalg.norm(pos2 - pos1) / 0.1))
        positions = np.linspace(pos1, pos2, num_checks)
        
        for pos in positions:
            for name, structure in anatomy.items():
                distance = self._distance_to_structure(pos, structure)
                
                # Check if within safety margin
                if distance < structure.safety_margin:
                    return True
        
        return False
    
    def _distance_to_structure(
        self,
        point: np.ndarray,
        structure: AnatomicalStructure
    ) -> float:
        """Calculate minimum distance to anatomical structure"""
        
        # Simple implementation using vertex distances
        # In production, use efficient spatial data structures
        
        vertices = structure.vertices
        distances = np.linalg.norm(vertices - point, axis=1)
        
        return np.min(distances)
    
    def _extract_path(self, tree: Dict[str, List], goal: np.ndarray) -> List[np.ndarray]:
        """Extract path from tree to goal"""
        
        # Find node closest to goal
        nodes = np.array(tree['nodes'])
        distances = np.linalg.norm(nodes - goal, axis=1)
        current_idx = np.argmin(distances)
        
        # Reconstruct path
        path = []
        while current_idx != -1:
            path.append(tree['nodes'][current_idx])
            current_idx = tree['parents'][current_idx]
        
        return list(reversed(path))
    
    def _generate_cache_key(
        self,
        start: np.ndarray,
        goal: np.ndarray,
        anatomy: Dict[str, AnatomicalStructure]
    ) -> str:
        """Generate cache key for planning results"""
        
        # Create hash from inputs
        import hashlib
        
        key_data = {
            'start': start.tobytes(),
            'goal': goal.tobytes(),
            'anatomy': str(sorted(anatomy.keys())).encode(),
        }
        
        key_string = json.dumps(key_data, sort_keys=True).encode()
        return hashlib.sha256(key_string).hexdigest()
    
    def get_performance_metrics(self) -> Dict[str, Any]:
        """Get performance metrics"""
        
        metrics = {}
        
        for key, values in self.metrics.items():
            if values:
                metrics[key] = {
                    'mean': np.mean(values),
                    'std': np.std(values),
                    'min': np.min(values),
                    'max': np.max(values),
                    'count': len(values),
                }
        
        return metrics

# Real-time motion controller
class SurgicalMotionController:
    """Real-time motion controller for surgical robotics"""
    
    def __init__(self, planner: SurgicalMotionPlanner):
        self.planner = planner
        
        # PID controllers for each degree of freedom
        self.position_controllers = []
        self.force_controllers = []
        
        # Safety systems
        self.safety_systems = SafetySystem()
        
        # State estimation
        self.state_estimator = StateEstimator()
        
        # Learning system
        self.learning_system = LearningSystem()
        
        # Real-time constraints
        self.control_frequency = 1000  # Hz
        self.max_control_latency = 0.001  # 1 ms
    
    def execute_procedure(
        self,
        procedure: Dict[str, Any],
        real_time_monitoring: bool = True
    ) -> Dict[str, Any]:
        """Execute complete surgical procedure"""
        
        results = {
            'steps': [],
            'overall_success': True,
            'total_time': 0.0,
            'safety_events': [],
        }
        
        start_time = time.time()
        
        for step_idx, step in enumerate(procedure['steps']):
            step_result = self._execute_step(step, real_time_monitoring)
            results['steps'].append(step_result)
            
            if not step_result['success']:
                results['overall_success'] = False
                break
            
            # Record safety events
            results['safety_events'].extend(step_result['safety_events'])
        
        results['total_time'] = time.time() - start_time
        
        return results
    
    def _execute_step(
        self,
        step: Dict[str, Any],
        real_time_monitoring: bool
    ) -> Dict[str, Any]:
        """Execute single surgical step"""
        
        # Plan trajectory for this step
        trajectory = self.planner.plan_trajectory(
            start_pose=step['start'],
            goal_pose=step['goal'],
            anatomy=step['anatomy'],
            surgical_tool=step['tool'],
            planning_method=step.get('planning_method', 'rrt_star')
        )
        
        # Execute trajectory
        execution_result = self.planner.execute_trajectory(
            trajectory=trajectory['trajectory'],
            real_time_callback=self._real_time_monitor if real_time_monitoring else None
        )
        
        # Learn from execution
        self.learning_system.learn_from_execution(
            trajectory=trajectory,
            execution_result=execution_result,
            step=step
        )
        
        return {
            'step_id': step['id'],
            'trajectory_planning': trajectory,
            'execution': execution_result,
            'success': execution_result['success'],
            'safety_events': execution_result['safety_violations'],
            'learning_update': self.learning_system.get_latest_update(),
        }
    
    def _real_time_monitor(self, step_idx: int, position: np.ndarray) -> bool:
        """Real-time monitoring callback"""
        
        # Check safety systems
        safety_status = self.safety_systems.check_safety(position)
        
        if not safety_status['safe']:
            # Take corrective action
            self._handle_safety_violation(safety_status)
            return False
        
        # Update state estimation
        self.state_estimator.update(position)
        
        return True
    
    def _handle_safety_violation(self, safety_status: Dict[str, Any]):
        """Handle safety violation"""
        
        # Emergency stop
        self._emergency_stop()
        
        # Notify human operator
        self._notify_operator(safety_status)
        
        # Record event
        self.safety_systems.record_violation(safety_status)

