        self.hidden_size = hidden_size
        
        # Clinical knowledge integration
        self.clinical_knowledge_proj = nn.Linear(hidden_size, hidden_size // 4)
        self.clinical_knowledge_norm = MedicalRMSNorm(hidden_size // 4)
        
        # Differential diagnosis attention
        self.differential_attention = nn.MultiheadAttention(
            embed_dim=hidden_size // 4,
            num_heads=4,
            dropout=0.1,
            batch_first=True
        )
        
        # Treatment planning
        self.treatment_planner = nn.Sequential(
            nn.Linear(hidden_size // 4, hidden_size // 2),
            nn.SiLU(),
            nn.Linear(hidden_size // 2, hidden_size // 4)
        )
        
        # Risk assessment
        self.risk_assessor = nn.Sequential(
            nn.Linear(hidden_size // 4, 64),
            nn.SiLU(),
            nn.Linear(64, 5)  # 5 risk levels
        )
    
    def forward(self, hidden_states: torch.Tensor, medical_context: Dict[str, Any]) -> torch.Tensor:
        # Extract clinical features
        clinical_features = self.clinical_knowledge_proj(hidden_states)
        clinical_features = self.clinical_knowledge_norm(clinical_features)
        
        # Apply differential diagnosis attention
        if 'symptoms' in medical_context:
            symptoms = medical_context['symptoms']
            differential_output, _ = self.differential_attention(
                clinical_features, symptoms, symptoms
            )
            clinical_features = clinical_features + differential_output
        
        # Treatment planning
        if 'diagnosis' in medical_context:
            treatment_plan = self.treatment_planner(clinical_features)
            clinical_features = clinical_features + treatment_plan
        
        # Risk assessment
        risk_scores = self.risk_assessor(clinical_features)
        medical_context['risk_scores'] = risk_scores
        
        # Project back to original dimension
        output = nn.functional.linear(clinical_features, 
                                     torch.eye(self.hidden_size // 4, self.hidden_size))
        
        return output

class SafetyLayer(nn.Module):
    """Safety layer for medical content verification"""
    
    def __init__(self, hidden_size: int):
        super().__init__()
        self.hidden_size = hidden_size
        
        # Safety classifier
        self.safety_classifier = nn.Sequential(
            nn.Linear(hidden_size, hidden_size // 2),
            nn.SiLU(),
            nn.Linear(hidden_size // 2, hidden_size // 4),
            nn.SiLU(),
            nn.Linear(hidden_size // 4, 3),  # SAFE, RISKY, DANGEROUS
            nn.Softmax(dim=-1)
        )
        
        # Fact checker
        self.fact_checker = nn.Sequential(
            nn.Linear(hidden_size, hidden_size // 2),
            nn.SiLU(),
            nn.Linear(hidden_size // 2, 1),  # Factuality score
            nn.Sigmoid()
        )
        
        # Ethical compliance
        self.ethical_compliance = nn.Sequential(
            nn.Linear(hidden_size, hidden_size // 2),
            nn.SiLU(),
            nn.Linear(hidden_size // 2, 5),  # 5 ethical principles
            nn.Softmax(dim=-1)
        )
        
        # Confidence calibration
        self.confidence_calibrator = nn.Sequential(
            nn.Linear(hidden_size, 64),
            nn.SiLU(),
            nn.Linear(64, 1),
            nn.Sigmoid()
        )
    
    def forward(self, hidden_states: torch.Tensor) -> Dict[str, torch.Tensor]:
        # Get safety scores
        safety_scores = self.safety_classifier(hidden_states)
        
        # Get factuality scores
        factuality_scores = self.fact_checker(hidden_states)
        
        # Get ethical compliance scores
        ethical_scores = self.ethical_compliance(hidden_states)
        
        # Get confidence scores
        confidence_scores = self.confidence_calibrator(hidden_states)
        
        # Determine if output is safe
        is_safe = (safety_scores.argmax(dim=-1) == 0) & \
                  (factuality_scores > 0.8) & \
                  (ethical_scores.min(dim=-1).values > 0.6)
        
        return {
            'safety_scores': safety_scores,
            'factuality_scores': factuality_scores,
            'ethical_scores': ethical_scores,
            'confidence_scores': confidence_scores,
            'is_safe': is_safe,
            'requires_human_review': ~is_safe
        }

class MedicalDecoderLayer(nn.Module):
    """Single decoder layer with medical reasoning capabilities"""
    
    def __init__(self, config: MedicalModelConfig, layer_idx: int):
        super().__init__()
        self.config = config
        self.layer_idx = layer_idx
        
        # Self-attention
        self.self_attn = MedicalAttention(config)
        self.input_layernorm = MedicalRMSNorm(config.hidden_size, eps=config.rms_norm_eps)
        
        # Clinical reasoning (for specific layers)
        self.is_clinical_layer = layer_idx in config.clinical_reasoning_layers
        if self.is_clinical_layer:
            self.clinical_reasoning = ClinicalReasoningLayer(config.hidden_size)
            self.clinical_norm = MedicalRMSNorm(config.hidden_size)
        
        # MLP
        self.mlp = MedicalMLP(config)
        self.post_attention_layernorm = MedicalRMSNorm(config.hidden_size, eps=config.rms_norm_eps)
        
        # Safety layer (for specific layers)
        self.is_safety_layer = layer_idx in config.safety_layer_indices
        if self.is_safety_layer:
            self.safety_layer = SafetyLayer(config.hidden_size)
    
    def forward(
        self,
        hidden_states: torch.Tensor,
        attention_mask: Optional[torch.Tensor] = None,
        position_ids: Optional[torch.Tensor] = None,
        past_key_value: Optional[Tuple[torch.Tensor]] = None,
        output_attentions: bool = False,
        use_cache: bool = False,
        medical_context: Optional[Dict[str, Any]] = None,
    ) -> Tuple[torch.Tensor, Optional[Tuple[torch.Tensor]]]:
        
        residual = hidden_states
        
        # Self-attention
        hidden_states = self.input_layernorm(hidden_states)
        self_attn_outputs = self.self_attn(
            hidden_states=hidden_states,
            attention_mask=attention_mask,
            position_ids=position_ids,
            past_key_value=past_key_value,
            output_attentions=output_attentions,
            use_cache=use_cache,
            medical_context=medical_context,
        )
        
        hidden_states = self_attn_outputs[0]
        hidden_states = residual + hidden_states
        
        # Clinical reasoning
        if self.is_clinical_layer and medical_context is not None:
            clinical_residual = hidden_states
            hidden_states = self.clinical_norm(hidden_states)
            clinical_output = self.clinical_reasoning(hidden_states, medical_context)
            hidden_states = clinical_residual + clinical_output
        
        # MLP
        residual = hidden_states
        hidden_states = self.post_attention_layernorm(hidden_states)
        hidden_states = self.mlp(hidden_states)
        hidden_states = residual + hidden_states
        
        # Safety checking
        safety_output = None
        if self.is_safety_layer:
            safety_output = self.safety_layer(hidden_states)
        
        outputs = (hidden_states,)
        
        if output_attentions:
            outputs += (self_attn_outputs[1],)
        
        if use_cache:
            outputs += (self_attn_outputs[2],)
        
        if safety_output is not None:
            outputs += (safety_output,)
        
        return outputs

