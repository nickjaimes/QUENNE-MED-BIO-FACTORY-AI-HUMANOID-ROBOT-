    def _calculate_overall_quality(self, results: Dict[str, Any]) -> Dict[str, float]:
        """Calculate overall printing quality"""
        
        quality_metrics = {}
        
        # Cell viability
        viability_values = []
        for layer in results['layers']:
            if 'quality_metrics' in layer:
                for metric in layer['quality_metrics'].values():
                    if 'cell_viability' in metric:
                        viability_values.append(metric['cell_viability'])
        
        if viability_values:
            quality_metrics['average_viability'] = np.mean(viability_values)
            quality_metrics['min_viability'] = np.min(viability_values)
        
        # Dimensional accuracy
        dimensional_errors = []
        for layer in results['layers']:
            if 'quality_metrics' in layer:
                for metric in layer['quality_metrics'].values():
                    if 'dimensional_error' in metric:
                        dimensional_errors.append(metric['dimensional_error'])
        
        if dimensional_errors:
            quality_metrics['average_dimensional_error'] = np.mean(dimensional_errors)
            quality_metrics['max_dimensional_error'] = np.max(dimensional_errors)
        
        # Structural integrity
        structural_scores = []
        for layer in results['layers']:
            if 'quality_metrics' in layer:
                for metric in layer['quality_metrics'].values():
                    if 'structural_score' in metric:
                        structural_scores.append(metric['structural_score'])
        
        if structural_scores:
            quality_metrics['average_structural_score'] = np.mean(structural_scores)
            quality_metrics['min_structural_score'] = np.min(structural_scores)
        
        # Overall quality score
        if all(key in quality_metrics for key in [
            'average_viability', 
            'average_dimensional_error',
            'average_structural_score'
        ]):
            quality_metrics['overall_quality_score'] = (
                0.4 * quality_metrics['average_viability'] / 100.0 +
                0.3 * (1.0 - quality_metrics['average_dimensional_error'] / 1000.0) +
                0.3 * quality_metrics['average_structural_score']
            )
        
        return quality_metrics
    
