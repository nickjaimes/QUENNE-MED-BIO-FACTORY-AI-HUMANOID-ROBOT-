/* Safety monitoring thread */
static int medical_safety_monitor(void *data)
{
    struct medical_scheduler *sched = data;
    u64 last_check_ns = ktime_get_ns();
    
    while (!kthread_should_stop()) {
        u64 now_ns = ktime_get_ns();
        u64 delta_ns = now_ns - last_check_ns;
        
        if (delta_ns >= NSEC_PER_MSEC) {  /* Check every millisecond */
            spin_lock(&sched->lock);
            
            /* Check all running tasks */
            struct medical_task *mtask;
            list_for_each_entry(mtask, &sched->running_tasks, list) {
                /* Check timing constraints */
                if (now_ns > mtask->deadline_ns) {
                    atomic_inc(&mtask->safety_violations);
                    sched->metrics.deadline_misses++;
                    
                    /* Emergency response */
                    if (mtask->ctx && mtask->ctx->emergency.emergency_stop)
                        mtask->ctx->emergency.emergency_stop(mtask->ctx);
                }
                
                /* Check resource usage */
                if (mtask->remaining_time_ns <= 0) {
                    atomic_inc(&mtask->safety_violations);
                    sched->metrics.schedule_overruns++;
                }
            }
            
            /* Update risk level */
            sched->safety.current_risk_level = 
                calculate_risk_level(sched->metrics.deadline_misses,
                                   sched->metrics.schedule_overruns);
            
            spin_unlock(&sched->lock);
            last_check_ns = now_ns;
        }
        
        /* Sleep with high precision */
        set_current_state(TASK_INTERRUPTIBLE);
        schedule_hrtimeout_range(&last_check_ns, NSEC_PER_MSEC, HRTIMER_MODE_REL);
    }
    
