                adjustments = self.metabolic_controller.compute_adjustments(
                    current=metabolic_status,
                    target=phase.metabolic_targets,
                    tissue_needs=current_state.metabolic_needs
                )
                self.apply_metabolic_adjustments(adjustments)
                
                # Gene expression monitoring
