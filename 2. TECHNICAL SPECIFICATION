        """Main thermal management control loop"""
        
        while True:
            # Measure current temperatures
            temperatures = self.temperature_sensors.read_all()
            
            # Predict future heat loads
            predicted_loads = self.heat_load_predictor.predict(
                current_loads=self.get_current_loads(),
                scheduled_tasks=self.task_scheduler.get_upcoming_tasks(),
                time_horizon=10
