                'value': value,
                'weight': metric.weight,
                'threshold': metric.threshold,
                'passing': value >= metric.threshold
            }
        
        # Overall assessment
        overall_score = self.calculate_overall_score(metrics)
        competency_level = self.determine_competency_level(
            score=overall_score,
            procedure_complexity=procedure_recording.complexity
        )
        
