class ControlModeManager:
    """Management of control mode transitions"""
    
    def __init__(self):
        self.mode_hierarchy = {
            'FULL_AUTONOMY': 5,
            'SHARED_CONTROL': 4,
            'COOPERATIVE': 3,
            'ASSISTED_MANUAL': 2,
            'FULL_MANUAL': 1
        }
        
        self.transition_validator = TransitionValidator(
            rules=self.transition_rules,
            safety_checks=self.safety_checks
        )
        
        self.context_manager = ContextAwareModeSelector(
            factors=['procedure_type', 'patient_condition', 'surgeon_skill', 'emergency_level']
        )
    
    def request_mode_change(self, requested_mode, reason, requester):
        """Handle control mode change request"""
        
        current_mode = self.current_mode
        current_context = self.get_current_context()
        
        # Validate transition
        validation = self.transition_validator.validate(
            from_mode=current_mode,
            to_mode=requested_mode,
            context=current_context,
            requester=requester
        )
        
        if not validation.valid:
            return {
                'success': False,
                'reason': validation.reason,
                'suggested_mode': validation.suggested_alternative
            }
        
        # Prepare for transition
        preparation = self.prepare_for_transition(
            from_mode=current_mode,
            to_mode=requested_mode,
            context=current_context
        )
        
        if not preparation.successful:
            return {
                'success': False,
                'reason': 'Transition preparation failed',
                'details': preparation.details
            }
        
        # Execute transition
        transition_result = self.execute_transition(
            from_mode=current_mode,
            to_mode=requested_mode,
            preparation=preparation
        )
        
        # Verify completion
        verification = self.verify_transition(
            expected_mode=requested_mode,
            actual_state=self.get_system_state()
        )
        
        if verification.successful:
            # Update current mode
            self.current_mode = requested_mode
            
            # Log transition
            self.log_transition(
                from_mode=current_mode,
                to_mode=requested_mode,
                reason=reason,
                requester=requester,
                context=current_context
            )
            
            # Notify stakeholders
            self.notify_stakeholders(
                old_mode=current_mode,
                new_mode=requested_mode,
                reason=reason
            )
            
            return {
                'success': True,
                'old_mode': current_mode,
                'new_mode': requested_mode,
                'transition_time': transition_result.duration
            }
        else:
            # Rollback
            rollback_result = self.rollback_transition(
                to_mode=current_mode,
                reason='Transition verification failed'
            )
            
            return {
                'success': False,
                'reason': 'Transition verification failed',
                'rolled_back': rollback_result.successful,
                'current_mode': self.current_mode
            }
